//R

// A customer (id = the store app's Clerk user id). Customers are global: a store's customers are the
// users with orders in that store. storeId is old and unused; it is dropped in phase 2 (see NEON-STEPS).
model Users {
  id        String    @id @unique
  storeId   String?
  store     Store?    @relation("StoreToUsers", fields: [storeId], references: [id])
  orders    Order[]   @relation("UsersToOrder") // relation to Order model
  email     String    @default("")
  phone     String    @default("")
  fname     String    @default("")
  address   Address[] @relation("Users-address") // relation to Address model
  imgurl    String?   @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
}

model Address {
  id           String  @id @default(uuid())
  value        String  @default("")
  instructions String? @default("")
  pincode      Int     @default(0)
  orders       Order[] @relation("AddressToOrder")
  usersId      String
  users        Users   @relation("Users-address", fields: [usersId], references: [id], onDelete: Cascade)

  @@index([usersId])
}

//R

// Only what is filtered, sorted or summed is a column; the rest lives in `details` (JSON, see lib/orders/details.ts).
model Order {
  id            String      @id @default(uuid())
  storeId       String
  store         Store       @relation("StoreToOrder", fields: [storeId], references: [id])
  // Short number per store (#1042): max + 1 inside the create transaction, unique with the store.
  orderNumber   Int
  usersId       String
  users         Users       @relation("UsersToOrder", fields: [usersId], references: [id], onDelete: Restrict)
  addressId     String
  address       Address     @relation("AddressToOrder", fields: [addressId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  total         Decimal     @db.Decimal(12, 2)
  details       Json
  // Old. Replaced by paymentStatus; no code reads or writes it. Dropped in phase 2.
  isPaid        Boolean     @default(false)
  payment       String      @default("COD")
  paymentStatus String      @default("PENDING")
  // The status text (the store's own list, Cancelled is reserved).
  status        String      @default("Placed")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([usersId])
  @@index([addressId])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([storeId, paymentStatus])
}

// Intermediary for a many-to-many relationship
model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  orderQuantity Int

  @@index([orderId])
  @@index([productId])
}

// Intermediary for a many-to-many relationship - Product <-> Value - Filter 
model filterItem {
  id        String  @id @default(uuid())
  valueId   String
  value     Value   @relation(fields: [valueId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([valueId])
  @@index([productId])
}

model Value {
  id          String       @id @default(cuid())
  filterItems filterItem[]
  filterId    String
  filter      Filter       @relation("FiltertoValue", fields: [filterId], references: [id], onDelete: Cascade)
  value       Decimal?
  unit        String

  @@index([filterId])
}

model Filter {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation("StoreToFilter", fields: [storeId], references: [id])
  value     Value[]  @relation("FiltertoValue")
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// The store's image library: every uploaded image (and every image link) the owner can reuse.
// Products, billboards and categories still keep only the url; "used in" is found by matching it.
model MediaImage {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation("StoreToMedia", fields: [storeId], references: [id])
  url       String
  publicId  String? // Cloudinary id. Empty for a plain link (source "url")
  source    String   @default("upload") // "upload" (Cloudinary file we own) | "url" (link only)
  name      String   @default("") // original file name, shown and searched
  createdAt DateTime @default(now())

  @@unique([storeId, url])
  @@index([storeId, createdAt])
}
