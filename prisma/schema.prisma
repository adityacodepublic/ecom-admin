generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Store {
  id         String      @id @default(uuid())
  name       String
  userId     String
  slug       String      @unique
  customDomain String?    @unique // the owner's own hostname, normalized lowercase (lib/custom-domain.ts), e.g. "shop.mybrand.com". Null = none. Column added by sql/custom-domain.sql.
  customDomainVerified Boolean @default(false) // true once Vercel confirms the domain's DNS (lib/store-domain.ts): only then does the storefront redirect and canonicalize to it. Column added by sql/custom-domain.sql.
  pageLayouts Json? // the store pages: { home: [...], category: [...], product: [...] } (lib/home-layout.ts). A missing page = its default.
  settings    Json? // { orders, contact, logo } (lib/store-settings.ts). Null = all defaults.
  agentAccess   Json? // AI agent link + pending requests + log (lib/agent/store.ts). Null = no link.
  transfer      Json? // pending hand-over of this store to another account (lib/transfer). Null = none.
  // NOTE: an expression index "Store_agentTokenHash_idx" on (agentAccess->'link'->>'tokenHash') exists only in sql/agent-access.sql (Prisma cannot declare it).
  categories Category[]  @relation("StoreToCategory")
  filters    Filter[]    @relation("StoreToFilter")
  products   Product[]   @relation("StoreToProduct")
  // variants    Variant[]     @relation("StoreToVariant")
  orders     Order[]     @relation("StoreToOrder")
  media      MediaImage[] @relation("StoreToMedia")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}


//G

model Category {
  id          String    @id @default(uuid())
  storeId     String // Foreign Key to Store
  store       Store     @relation("StoreToCategory", fields: [storeId], references: [id])
  name        String
  imageUrl    String // the thumbnail (the category icons on the home page)
  banner      Json      @default("[]") // the category's billboard: [{ url, href }] in order (lib/home-layout.ts billboardImagesSchema)
  products    Product[] @relation("CategoryToProduct")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId])
}

model Product {
  id          String       @id @default(uuid())
  storeId     String // Foreign Key to Store
  store       Store        @relation("StoreToProduct", fields: [storeId], references: [id])
  categoryId  String // Foreign Key to Category
  category    Category     @relation("CategoryToProduct", fields: [categoryId], references: [id])
  // variantId   String
  // variant     Variant      @relation("VariantToProduct", fields: [variantId], references: [id])
  name        String       @db.VarChar(255)
  price       Decimal?     @db.Decimal(12, 2) // rupees, exact (2 decimals). In code: integer paise (lib/money.ts). null = "Price on request" (a quote)
  isFeatured  Boolean      @default(false)
  isArchived  Boolean      @default(false)
  quantity    Int
  maxQuantity Int
  description String? @db.Text // Markdown shown on the store product page
  images      Image[] // Relation to Image model
  filteritems filterItem[] // Relation to Filter model
  orderItems  OrderItem[] // Relation to Order model
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // @@index([variantId])

  @@index([storeId])
  @@index([categoryId])
}

model Image {
  id        String   @id @default(uuid())
  productId String   @default("") // Foreign Key to Product
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // URL of the image
  order     Int      @default(1) // Order/position of the image
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

