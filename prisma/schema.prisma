//R

// A customer (id = the store app's Clerk user id). Customers are global: a store's customers are the
// users with orders in that store.
model Users {
  id        String    @id @unique
  orders    Order[]   @relation("UsersToOrder") // relation to Order model
  email     String    @default("")
  phone     String    @default("")
  fname     String    @default("")
  address   Address[] @relation("Users-address") // relation to Address model
  imgurl    String?   @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id           String  @id @default(uuid())
  street       String  @default("") // house / flat, street, area
  city         String  @default("")
  state        String  @default("")
  country      String  @default("India")
  instructions String? @default("")
  pincode      Int     @default(0)
  orders       Order[] @relation("AddressToOrder")
  // Null = the shopper removed this saved address but an order still points at it (sql/address-detach.sql). Orders show their own frozen copy.
  usersId      String?
  users        Users?  @relation("Users-address", fields: [usersId], references: [id], onDelete: Cascade)

  @@index([usersId])
}

//R

// Only what is filtered, sorted or summed is a column; the rest lives in `details` (JSON, see lib/orders/details.ts).
model Order {
  id            String      @id @default(uuid())
  storeId       String
  store         Store       @relation("StoreToOrder", fields: [storeId], references: [id])
  // Short number per store (#1042): max + 1 inside the create transaction, unique with the store.
  orderNumber   Int
  usersId       String
  users         Users       @relation("UsersToOrder", fields: [usersId], references: [id], onDelete: Restrict)
  addressId     String
  address       Address     @relation("AddressToOrder", fields: [addressId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  total         Decimal     @db.Decimal(12, 2)
  details       Json
  payment       String      @default("COD")
  paymentStatus String      @default("PENDING")
  // The status text (the store's own list, Cancelled is reserved).
  status        String      @default("Placed")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([usersId])
  @@index([addressId])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([storeId, paymentStatus])
}

// A shopper's saved cart: one row per product (lib/cart.ts, created by sql/cart.sql). No relations on
// purpose: the shopper may have no Users row yet, and a deleted product's row is removed on the next read.
model CartItem {
  id         String   @id @default(uuid())
  storeId    String
  customerId String // the store app's Clerk user id
  productId  String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, storeId, productId])
  @@index([storeId])
  @@index([productId])
}

// Intermediary for a many-to-many relationship
model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  orderQuantity Int

  @@index([orderId])
  @@index([productId])
}

// Intermediary for a many-to-many relationship - Product <-> Value - Filter 
model filterItem {
  id        String  @id @default(uuid())
  valueId   String
  value     Value   @relation(fields: [valueId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([valueId])
  @@index([productId])
}

model Value {
  id          String       @id @default(cuid())
  filterItems filterItem[]
  filterId    String
  filter      Filter       @relation("FiltertoValue", fields: [filterId], references: [id], onDelete: Cascade)
  value       Decimal?
  unit        String

  @@index([filterId])
}

model Filter {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation("StoreToFilter", fields: [storeId], references: [id])
  value     Value[]  @relation("FiltertoValue")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

// The store's image library: every uploaded image (and every image link) the owner can reuse.
// Products, categories, page blocks and the logo keep only the url; "used in" is found by matching it.
model MediaImage {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation("StoreToMedia", fields: [storeId], references: [id])
  url       String
  publicId  String? // Cloudinary id. Empty for a plain link (source "url")
  source    String   @default("upload") // "upload" (Cloudinary file we own) | "url" (link only)
  name      String   @default("") // original file name, shown and searched
  createdAt DateTime @default(now())

  @@unique([storeId, url])
  @@index([storeId, createdAt])
}

// ---------------------------------------------------------------- Better Auth (the STOREFRONT's shopper sign-in)
// The storefront (next13-ecommerce-store, lib/auth.ts) stores its shoppers in these four tables of the same database.
// The admin never reads them (it signs in with Clerk): they are declared here only so this schema stays the single,
// drift-free description of the database. Created by sql/better-auth.sql, in Better Auth's own layout (camelCase
// columns, text ids, timestamptz), under ba_* names so they never collide with "Users" (the shoppers' profiles).
model BaUser {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @db.Timestamptz(6)
  sessions      BaSession[]
  accounts      BaAccount[]

  @@map("ba_user")
}

model BaSession {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      BaUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ba_session")
}

model BaAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  BaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)

  @@index([userId])
  @@map("ba_account")
}

model BaVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier])
  @@map("ba_verification")
}
