{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "$ref": "#/definitions/product"
      },
      {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/definitions/product"
          }
        },
        "required": ["data"],
        "additionalProperties": false
      }
    ]
  },
  "definitions": {
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isArchived": {
          "type": "boolean"
        },
        "categoryId": {
          "type": "string"
        },
        "filteritems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "valueId": {
                "type": "string"
              }
            },
            "required": ["valueId"],
            "additionalProperties": false
          }
        },
        "quantity": {
          "type": "number"
        },
        "maxQuantity": {
          "type": "number"
        },
        "images": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "required": ["url"],
                "additionalProperties": false
              }
            },
            {
              "type": "object",
              "properties": {
                "createMany": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": ["url"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["data"],
                  "additionalProperties": false
                }
              },
              "required": ["createMany"],
              "additionalProperties": false
            }
          ]
        },
        "ram": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "price",
        "isFeatured",
        "isArchived",
        "categoryId",
        "quantity",
        "maxQuantity",
        "images"
      ],
      "additionalProperties": true
    }
  }
}
